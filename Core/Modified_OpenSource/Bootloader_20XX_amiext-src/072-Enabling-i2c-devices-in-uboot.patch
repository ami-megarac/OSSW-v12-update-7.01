From 7daaa151b9a407973cc495ee7f016e2d41f386b9 Mon Sep 17 00:00:00 2001
From: vijayks <vijayks@ami.com>
Date: Fri, 22 Dec 2023 19:57:32 +0530
Subject: [PATCH] Enabling i2c devices in uboot

Signed-off-by: vijayks <vijayks@ami.com>
---
 cmd/i2c.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/cmd/i2c.c b/cmd/i2c.c
index b8cd0cec..217942e9 100644
--- a/cmd/i2c.c
+++ b/cmd/i2c.c
@@ -1808,6 +1808,8 @@ static int do_i2c_bus_num(cmd_tbl_t *cmdtp, int flag, int argc,
 	int		ret = 0;
 	int	bus_no;
 
+	*((volatile ulong*) 0x1e6e2000) = 0x1688A8A8;   /* unlock SCU */
+
 	if (argc == 1) {
 		/* querying current setting */
 #ifdef CONFIG_DM_I2C
@@ -1826,6 +1828,7 @@ static int do_i2c_bus_num(cmd_tbl_t *cmdtp, int flag, int argc,
 #if defined(CONFIG_SYS_I2C)
 		if (bus_no >= CONFIG_SYS_NUM_I2C_BUSES) {
 			printf("Invalid bus %d\n", bus_no);
+			*((volatile ulong*) 0x1e6e2000) = 0;   /* lock SCU */
 			return -1;
 		}
 #endif
@@ -1839,6 +1842,8 @@ static int do_i2c_bus_num(cmd_tbl_t *cmdtp, int flag, int argc,
 			printf("Failure changing bus number (%d)\n", ret);
 	}
 
+	*((volatile ulong*) 0x1e6e2000) = 0;   /* lock SCU */
+
 	return ret ? CMD_RET_FAILURE : 0;
 }
 #endif  /* defined(CONFIG_SYS_I2C) */
-- 
